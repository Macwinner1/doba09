# Fail loudly on the wrong Node rather than surfacing it as a strange build
# error deep in Nest or Next. See .nvmrc for the expected version.
engine-strict=true

# Nest and Next both rely on transitive deps being reachable; pnpm's strict
# default breaks a few of their plugins.
shamefully-hoist=false
auto-install-peers=true
strict-peer-dependencies=false
