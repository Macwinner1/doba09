{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // CommonJS so the NestJS backend (which compiles to CJS) can require this
    // package directly. Next.js consumes CJS without complaint.
    "module": "CommonJS",
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
