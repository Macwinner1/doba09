NODE_ENV=development
PORT=4000

# Note the non-default ports — docker-compose maps 5433/6380 so the project
# never collides with a Postgres or Redis you already run locally.
DATABASE_URL=postgresql://feyi:feyi@localhost:5433/feyi?schema=public
REDIS_URL=redis://localhost:6380

# Generate real values before deploying: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGIN=http://localhost:3000

# Where the frontend lives — used to build password reset links.
APP_URL=http://localhost:3000

# Email. With no SMTP_HOST the server prints messages to the console, so a
# password reset can be completed locally with no signup. Required in production.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=Feyi <no-reply@feyi.local>
