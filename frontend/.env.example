# Where the NestJS API lives. Used for the /api proxy rewrite and the socket URL.
#
# If this is a loopback address, the browser follows the hostname the page was
# served from and keeps only this port — so opening the app at
# http://192.168.1.5:3000 makes phones connect to 192.168.1.5:4000, which is
# what lets the lobby QR code work on a LAN with no extra configuration.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Base URL encoded into the lobby's scan-to-join QR code. Leave unset to use
# whatever address the host is browsing on. Set it when the host presents from
# localhost but players are on phones, or in production.
# NEXT_PUBLIC_APP_URL=http://192.168.1.5:3000
